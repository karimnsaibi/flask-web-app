# Copy this file to .env and fill in real values. .env is gitignored, never commit it.

# --- Database (docker compose reads these too) ---
POSTGRES_DB=tt_network
POSTGRES_USER=tt_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tt_app:change-me@localhost:5432/tt_network

# Read-only account Power BI connects with (created by init_db.py)
POWERBI_PASSWORD=change-me-too

# --- Flask ---
FLASK_SECRET_KEY=any-long-random-string

# --- Email activation + 2FA (off by default so the demo runs without email) ---
ENABLE_EMAIL_2FA=false
EMAIL_USER=your.address@gmail.com
EMAIL_PASSWORD=your-16-letter-gmail-app-password

# Password given to every demo account created by seed_data.py
DEMO_PASSWORD=demo1234
